*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Scrapy
.scrapy/

# Pytest
.pytest_cache/

# Logs
*.log
logs/

# Output folder - selective inclusion
output/*.jsonl
output/*_backup*.db
output/*.pre_v*_backup
output/*.csv
output/rentals.db

# Database backups — contain full prod/scraped data, must NEVER be committed (#38)
output/backups/
neon_backups/
neon_*.sql.gz
*.sql.gz
*.dump
dedupe_deleted_backup_*.csv
output/deleted_backups/    # safe-delete guard backups (#37)
# Golden-master immutable archives — full recovered dataset, keep local only (#38 L6)
golden_master/*.db
golden_master/*.manifest.txt
golden_master/*.manifest.json

# Keep analysis PNGs
!output/*.png

# For-sale serving artifacts (Inc4) — small JSON sidecars, committed like the
# rental chrome-extension/api/{model,features}.json. Never .db/.pkl/.csv.
# These `!` rules are no-ops today (nothing above matches them) but future-proof
# against a broadening `output/*.json` ignore silently dropping the sale serving
# inputs; they do NOT un-ignore output/sale_model.pkl (blocked by *.pkl, intended).
!output/sale_api/model.json
!output/sale_api/features.json
!output/sale_model_inference.json
!output/sale_feature_parity_golden.json

# Catboost
catboost_info/

# Model artifacts (large files)
*.pkl
*.joblib
models/

# Exploration/temp
exploration/
savills_exploration/
*.txt
!requirements.txt

# Jupyter
.ipynb_checkpoints/

# Environment variables
.env
.env.local
.env.prod
.env*.prod

# Archive old scripts
archive/

# Temporary files
*.tmp
*.temp
.vercel
.env*.local

# SQLite sidecar files (never commit WAL/SHM)
*.db-wal
*.db-shm
# Coverage + TS build info
.coverage
*.tsbuildinfo
# Working/scratch databases — DATA, never commit (#38)
output/*.db
output/**/*.db
output/_validate*
output/_git_recovery/*.db
output/rentals_merged.db
output/rentals_modeler_copy.db
# DB backups / SQL dumps — full data copies, never commit (#38)
*.bak
output/*.bak
output/*.sql
output/rentals.db.*
output/*_recovery*.sql

# Test fixtures (#CI mini-db): the committed, reviewable baseline fixture IS tracked;
# the derived post-backfill variant conftest builds on demand is NOT.
tests/fixtures/_mini_rentals_backfilled.db
!tests/fixtures/mini_rentals.db

# The generic Python-packaging `lib/` ignore (above) also catches dashboard/src/lib/,
# which is REAL serving source (db.ts + the single-source similarQuery module the
# /api/similar route imports). Un-ignore the dashboard lib + its test harnesses so the
# route's query module is tracked (deployment imports it).
!dashboard/src/lib/
!dashboard/src/lib/**
!dashboard/test/
!dashboard/test/**
